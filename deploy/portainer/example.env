# Set these in Portainer's stack environment variables. Do not commit real passwords.
LAB_NODE=your-swarm-node-hostname
# Only used by the generic stacks/build scripts; GHCR stacks pin image digests.
LAB_IMAGE_PREFIX=wiremock-lab
LAB_TAG=20260930
CAPTURE_PREFIX=wiremock-comparison-unique-name
CAPTURE_ENABLED=true
# Standalone broker only: use a URL-safe password (for example random hex).
RABBIT_PASSWORD=replace-with-a-random-hex-password
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-a-strong-password
# Existing PocketHive broker variant only; percent-encode URI credentials/vhost.
POCKETHIVE_RABBIT_URI=amqp://username:password@reachable-broker-host:5672/%2f
OFFICIAL_PORT=19080
HEADLESS_PORT=19081
GRAFANA_PORT=13000
PROMETHEUS_PORT=29090
RABBIT_AMQP_PORT=5673
RABBIT_UI_PORT=15673
