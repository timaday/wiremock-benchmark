  "templating": {
    "list": [
      {
        "name": "runtime",
        "label": "Runtime",
        "type": "custom",
        "query": "official,headless",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
