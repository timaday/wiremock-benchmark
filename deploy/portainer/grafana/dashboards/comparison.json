{
  "uid": "wiremock-comparison",
  "title": "WireMock runtime comparison",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "wiremock",
    "benchmark"
  ],
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Compare the same load, one runtime at a time",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Point any HTTP generator at **official :19080** or **headless :19081** (default ports). Use the same request rate, payload/template mix and duration. HTTP charts count `/bench/` only. **Server latency includes the configured delay; histogram percentiles are estimates.** JVM heap and process CPU are measured; container RSS is not shown. Captures have three phases per exchange. Counters and an empty queue do not prove reconciliation. The PocketHive-broker variant leaves shared-broker monitoring unchanged; Rabbit panels have no data. Check all client results and archived IDs/hashes before declaring a pass."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Completed HTTP requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "wiremock-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(wiremock_http_completed_total{runtime=~\"$runtime\"}[$__rate_interval])",
          "legendFormat": "{{runtime}}",
          "datasource": {
            "type": "prometheus",
            "uid": "wiremock-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
