# One named Portainer Swarm stack per runtime; fresh storage paths per stack.
OFFICIAL_DIRECT_IMAGE=ghcr.io/timaday/wiremock-lab-official@sha256:c7c0aa65662e6bc05093a2ee45df710e115e54cdee3d58f58894ec608f688b68
HEADLESS_DIRECT_IMAGE=ghcr.io/timaday/wiremock-lab-headless@sha256:91f333c4c78750e33b51188f7f1b569aef0348a3e1f40508ad3d0d0cd9c29737
ARCHIVE_IMAGE=ghcr.io/timaday/wiremock-lab-archive@sha256:7de1ee0bb9870be4195058fec0ee3958fd98665c45e2c1f7c8eeb3ce506697ed
CAPTURE_IDENTITY_MODE=BENCHMARK_HEADERS
LAB_NODE=your-mock-worker
RABBIT_NODE=your-broker-worker
ARCHIVE_NODE=your-archive-worker
# Existing directories on local SSD/EBS, NOT EFS/NFS or Docker's EFS-backed root.
RABBIT_DATA_DIR=/srv/wiremock-direct/rabbit
ARCHIVE_DATA_DIR=/srv/wiremock-direct/archive
# Replace with output of: openssl rand -hex 24
RABBIT_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
CAPTURE_PREFIX=wiremock-direct-dedicated-run
CAPTURE_QUEUE_MAX_BYTES=1073741824
CAPTURE_QUEUE_MAX_MESSAGES=200000
RABBIT_DISK_FREE_LIMIT_BYTES=5368709120
CAPTURE_CONFIRM_TIMEOUT_MS=10000
WIREMOCK_ACCEPT_BACKLOG=4096
OFFICIAL_PORT=19380
HEADLESS_PORT=19381
RABBIT_UI_PORT=15675
