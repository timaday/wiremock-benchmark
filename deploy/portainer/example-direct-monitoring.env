# Add these settings to example-direct-rabbit.env for a *-rabbit-monitored.yml stack.
MONITORING_NODE=your-monitoring-worker
# Existing local XFS/ext4 directories on MONITORING_NODE, never EFS/NFS.
# Writable by 65534:65534 (Prometheus) and 472:0 (Grafana).
PROMETHEUS_DATA_DIR=/data/wb/prometheus
GRAFANA_DATA_DIR=/data/wb/grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
# Use another port and separate storage directories for a second stack.
GRAFANA_PORT=13300
