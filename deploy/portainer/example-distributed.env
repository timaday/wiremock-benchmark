# Replace these with exact, eligible Swarm node hostnames.
# One selected mock uses worker 1; do not run both on that worker during comparison.
OFFICIAL_NODE=your-worker-1
HEADLESS_NODE=your-worker-1
RABBIT_NODE=your-worker-2
ARCHIVE_NODE=your-worker-3
MONITORING_NODE=your-manager-with-spare-capacity
OFFICIAL_REPLICAS=0
HEADLESS_REPLICAS=1
CAPTURE_PREFIX=wiremock-distributed-unique-name
CAPTURE_ENABLED=true
WIREMOCK_ACCEPT_BACKLOG=4096
# Use a URL-safe Rabbit password, for example random hex. Never commit real passwords.
RABBIT_PASSWORD=replace-with-a-random-hex-password
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-a-strong-password
# Separate from the single-node stack's ports; confirm availability before deployment.
OFFICIAL_PORT=19180
HEADLESS_PORT=19181
GRAFANA_PORT=13100
PROMETHEUS_PORT=29190
RABBIT_AMQP_PORT=5674
RABBIT_UI_PORT=15674
