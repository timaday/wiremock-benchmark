# Upload one stack-direct-*.yml per Portainer stack, each with its own name.
# Published public GHCR images, pinned to the tested direct-capture builds.
OFFICIAL_DIRECT_IMAGE=ghcr.io/timaday/wiremock-lab-official@sha256:c7c0aa65662e6bc05093a2ee45df710e115e54cdee3d58f58894ec608f688b68
HEADLESS_DIRECT_IMAGE=ghcr.io/timaday/wiremock-lab-headless@sha256:91f333c4c78750e33b51188f7f1b569aef0348a3e1f40508ad3d0d0cd9c29737
LAB_NODE=your-worker-hostname
POCKETHIVE_NETWORK=your-existing-pockethive-overlay
POCKETHIVE_RABBIT_URI=amqp://user:password@your-rabbit-service:5672/%2f
CAPTURE_PREFIX=wiremock-direct-unique-run
RABBIT_QUEUE_TYPE=classic
CAPTURE_CONFIRM_TIMEOUT_MS=10000
WIREMOCK_ACCEPT_BACKLOG=4096
OFFICIAL_PORT=19280
HEADLESS_PORT=19281
